# Dockerfile de développement pour le backend
FROM node:18-alpine

# Installation de curl pour les health checks
RUN apk add --no-cache curl

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances (incluant les dev dependencies)
RUN npm install

# Copier le code source
COPY . .

# Exposer le port
EXPOSE 5001

# Commande de développement avec nodemon pour le hot reload
CMD ["npm", "run", "dev"]

# ====================================================================
# CONFIGURATION ENVIRONNEMENT FT_TRANSCENDENCE - TEMPLATE
# ====================================================================
# Fichier template pour la configuration environnement
# Copiez ce fichier vers .env et modifiez les valeurs

# ====================================================================
# BASE DE DONNÉES POSTGRESQL
# ====================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_transcendence
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password

# Contrôle de la base de données (true pour reset complet)
RESET_DB=false

# ====================================================================
# SERVEUR & SÉCURITÉ
# ====================================================================
NODE_ENV=development
PORT=5001
HTTPS_PORT=3443

# CHANGEZ ABSOLUMENT EN PRODUCTION !
JWT_SECRET=change_this_super_secret_jwt_key_in_production

# Rounds pour bcrypt (12 recommandé)
SALT_ROUNDS=12

# Origines CORS autorisées
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ====================================================================
# OAUTH PROVIDERS
# ====================================================================
# 42 School
CLIENT_ID_42=your_42_client_id
CLIENT_SECRET_42=your_42_client_secret
REDIRECT_URI=http://localhost:5001/auth/42/callback

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5001/auth/github/callback

# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback

# ====================================================================
# EMAIL CONFIGURATION
# ====================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@transcendence.42.com

# ====================================================================
# VAULT CONFIGURATION
# ====================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=myroot

# ====================================================================
# AUTRES
# ====================================================================
PRIVACY_POLICY_VERSION=1.0
DEBUG=true
LOG_LEVEL=info
VITE_BACKEND_URL=http://localhost:5001
COMPOSE_PROJECT_NAME=ft_transcendence

# Configuration ft_transcendence - FICHIER D'EXEMPLE
# Copiez ce fichier vers .env et remplacez les valeurs par les vôtres

NODE_ENV=dev
HTTPS_PORT=5001

# Docker
POSTGRES_VERSION=14

# =================================================================
# CONFIGURATION SENSIBLE - À MODIFIER AVANT PRODUCTION
# =================================================================

# Base de données PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=db_transcendence

# Vault (HashiCorp)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=your_secure_vault_token

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# OAuth 42 (https://profile.intra.42.fr/oauth/applications)
CLIENT_ID_42=your_42_client_id
CLIENT_SECRET_42=your_42_client_secret

# OAuth GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email SMTP (Gmail recommandé)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

